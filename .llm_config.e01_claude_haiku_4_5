# Capability level 1 of 4 -- the cheapest model at the lowest effort. Apparatus checks only
# (run_turbo_e01.bat, the whole matrix): proves the chain runs; its rows are never ranked.
# The model id below is the ONLY vendor-specific line in the repository: the level is what file
# names, batch files and documents refer to. Read once per run by run_master.py (KEY=VALUE, text
# after # is a comment). Project and methodology are NOT set here -- they come from the command
# line: run.bat <project> <methodology>.

ENGINE=claude
# ENGINE: only valid value is "claude" (chapter 9).
MODEL=claude-haiku-4-5
# MODEL: the campaign model, unchanged — a sweep that also moved the model would tell us nothing
# about the harness.
PROVIDER=
# PROVIDER: blank = anthropic, this vendor's own endpoint. Any other value (moonshot, groq,
# openrouter, local, ...) needs BASE_URL and is recorded as cfg_provider -- a campaign constant,
# because one model id served from two places is two populations, not one.
BASE_URL=
# BASE_URL: blank = native. The endpoint the CLI is pointed at; recorded as cfg_endpoint.
# Together the two set cfg_effort_enforced (--effort is this vendor's flag) and cfg_bound (the cap
# that actually binds: --max-budget-usd only where the endpoint reports cost, else the timeout).
EFFORT=low
# EFFORT: the cheapest setting. This is what makes the sweep affordable and what disqualifies its
# rows from the campaign pivot.
MAX_TURNS=60
# MAX_TURNS: reporting threshold behind res_hit_turn_cap; never passed to the CLI.
MAX_BUDGET_USD=1.00
# MAX_BUDGET_USD: a quarter of the campaign cap. 174 runs, so the ceiling is what matters.
REPEATS=1
# REPEATS: one observation per pair. The sweep exercises the matrix; it does not measure it.
CLAUDE_CONFIG_DIR=
# blank = leave the CLI on the user config dir; set to a path (relative to the repo root)
# to isolate the campaign from the user profile. Needs a one-time "claude login" in it.

REVIEW_PASS=none
# REVIEW_PASS: none | same_model | other_model (chapter 12, step 7b). none on the sweep: the sweep
# answers "does every pair still run", and a second invocation on 174 runs is not that question.
REVIEW_MAX_BUDGET_USD=1.00
# REVIEW_MAX_BUDGET_USD: the review invocation's own cap. Unused while REVIEW_PASS=none.
REVIEW_MODEL=
# REVIEW_MODEL: blank = the implementer's model on same_model; the vendor id on other_model.
REVIEW_CMD=
# REVIEW_CMD: other_model only, the reviewer command; blank there aborts with exit 6.
REVIEW_PROMPT=
# REVIEW_PROMPT: blank = lib/reviewer_prompt.md. Unused while REVIEW_PASS=none.
REVIEW_WEIGHT=1
# REVIEW_WEIGHT: one reviewer per pass. Unused while REVIEW_PASS=none, and a sweep does not buy a
# sample of reviewers.
REVIEW_FEEDBACK=0
# REVIEW_FEEDBACK: off. 1 needs REVIEW_PASS != none, and the sweep runs no review.
FIX_MODEL=
# FIX_MODEL: blank = MODEL for the step-7c fix call. Only meaningful with REVIEW_FEEDBACK=1, which
# the sweep does not run; a canonical id only, the same alias rejection as MODEL.
BEST_OF_N=1
# BEST_OF_N: one invocation per pair. N>1 multiplies the sweep by N and answers a different
# question than "does every pair still run".
